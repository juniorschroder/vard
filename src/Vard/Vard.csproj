<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Vard</RootNamespace>
    <AssemblyName>Vard</AssemblyName>

    <!-- Metadados de Identificação NuGet -->
    <PackageId>Vard</PackageId>
    <Version>1.0.0</Version>
    <Authors>Junior Schröder</Authors>
    <Company>Junior Schröder</Company>
    <Description>Toolkit de resiliência sem atrito, type-safe, com zero dependências externas para .NET (.NET Standard 2.1+). Implementa Retry com jitter, Circuit Breaker (count e rate-based com janela deslizante O(1)), Timeout, Fallback, Bulkhead, Rate Limiter (Token Bucket e Sliding Window), Hedging e composição de pipelines via PolicyWrap.</Description>
    <PackageTags>resilience;fault-tolerance;retry;circuit-breaker;timeout;fallback;bulkhead;rate-limiter;hedging;polly;dotnet</PackageTags>
    <PackageProjectUrl>https://github.com/juniorschroder/Vard</PackageProjectUrl>
    <RepositoryUrl>https://github.com/juniorschroder/Vard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Documentação XML e Empacotamento de README -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Pacote de Símbolos -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../vard-banner.jpg" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Vard.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
